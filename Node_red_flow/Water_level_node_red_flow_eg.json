    {
        "id": "f70d77be2b5baaae",
        "type": "function",
        "z": "4bb2fbde13106428",
        "name": "connected or disconnected",
        "func": "if(global.get(\"flag\")==1){\n    msg={\n        payload:\"Disconnected\"\n    }\n    var water_level_rst={\n        payload:0\n    }\n    var tele_gram={\n        payload:{\n            chatId: \"6464678817\",\n            type: \"message\",\n            content: \"Water level sensor disconnected\"\n        }\n    }\n    global.set(\"connectionstatus\", \"Disconnected\")\n}\nelse if(global.get(\"flag\")==0){\n    global.set(\"flag\",1)\n}\nreturn [msg,water_level_rst,tele_gram];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
